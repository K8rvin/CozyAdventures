{
  "name": "cozy-adventures",
  "version": "0.1.0",
  "description": "Лавка на перекрёстке миров — уютная игра про хозяина волшебной лавки",
  "type": "module",
  "scripts": {
    "build": "esbuild src/ui/app.js --bundle --format=iife --outfile=bundle.js",
    "config": "node tools/build-public-config.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "serve": "python -m http.server 8080",
    "assets": "node tools/generate-assets.mjs",
    "assets:variants": "node tools/generate-assets.mjs --variants",
    "knight:art": "node tools/build-knight-art.mjs",
    "achievements:art": "node tools/build-achievement-art.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "pg": "^8.23.1"
  }
}

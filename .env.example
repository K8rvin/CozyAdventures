KNIGHT_HOST=knight-api.example.com
COZY_API_BASE_URL=https://knight-api.example.com
KNIGHT_PUBLIC_URL=https://knight-api.example.com

POSTGRES_USER=cozy
POSTGRES_PASSWORD=replace-with-database-password
POSTGRES_DB=cozy
DATABASE_URL=postgresql://cozy:replace-with-database-password@db:5432/cozy
BACKUP_KEEP_DAYS=14

KNIGHT_IMAGE_PROVIDER=openrouter
OPENROUTER_API_KEY=replace-with-openrouter-api-key
OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image
KNIGHT_ALLOWED_ORIGINS=https://frontend.example.com
KNIGHT_RATE_LIMIT=20
KNIGHT_LOGIN_RATE_LIMIT=10

VLESS_URL=vless://replace-with-complete-vless-url
DUCKDNS_TOKEN=replace-with-duckdns-token
TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token
ACME_EMAIL=admin@example.com
